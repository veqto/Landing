# ─── LANDING-LEADS ─────────────────────────────────────────────────────────
# El endpoint que recibe los leads vive en la PLATAFORMA (app.veqto.ai): los
# leads deben caer en la vista de Leads que usa operación, no en una base
# paralela de la landing.
#
# OBLIGATORIA en producción. Sin ella el cliente no envía nada y muestra un
# error explícito, en vez de aceptar leads que nadie va a ver.
# En desarrollo se puede dejar vacía: las peticiones caen al mismo origen, donde
# las sirve el mock local — que además exige LANDING_LEADS_MOCK=1 (ver abajo).
NEXT_PUBLIC_LANDING_LEADS_BASE_URL=https://app.veqto.ai

# ─── Mock de desarrollo ────────────────────────────────────────────────────
# El route handler local /api/landing-leads es SOLO un mock para desarrollar los
# formularios sin depender de la plataforma. Devuelve 404 salvo que se cumplan
# LAS DOS condiciones: NODE_ENV != production Y LANDING_LEADS_MOCK=1.
#
# Para desarrollo local, dejando NEXT_PUBLIC_LANDING_LEADS_BASE_URL vacia:
#     LANDING_LEADS_MOCK=1 npm run dev
#
# NO configurar en Vercel, ni en produccion ni en preview.
# LANDING_LEADS_MOCK=1

# Cloudflare Turnstile — lo verifica la PLATAFORMA, no la landing.
# La landing solo necesita la site key pública para pintar el widget.
# El secreto (TURNSTILE_SECRET_KEY) va en la plataforma y NO aquí.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── BASE DE DATOS: NO CONFIGURAR EN ESTA LANDING ──────────────────────────
# DATABASE_URL y DIRECT_URL NO se configuran en el Vercel de la landing.
#
# El almacenamiento de leads es responsabilidad de la plataforma. Aquí no se
# escribe en ninguna base:
#   · db/migrations/001_landing_leads.sql NO se aplica a ninguna base — es solo
#     referencia histórica para quien implemente el endpoint en la plataforma.
#   · npm run db:push / db:generate / db:seed / db:studio están BLOQUEADOS
#     a propósito en package.json.
#
# El schema Drizzle en src/db/ se conserva como documentación del modelo de
# datos, no como algo que esta app aplique o consulte.
#
# DATABASE_URL=  ← dejar sin configurar
# DIRECT_URL=    ← dejar sin configurar

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://veqto.co
NEXT_PUBLIC_APP_NAME=Veqto
