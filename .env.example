DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:pass@host/dbname?sslmode=require
NEXT_PUBLIC_APP_URL=https://veqto.co
NEXT_PUBLIC_APP_NAME=Veqto

# ─── LANDING-LEADS (POST /api/landing-leads) ───────────────────────────────
# El endpoint vive en el mismo origen que la landing, así que NO hace falta
# ninguna variable para que el formulario funcione. DATABASE_URL sí es
# obligatoria en runtime: es donde se guardan las solicitudes.

# Opcional. Solo para apuntar a otro host (p.ej. un preview contra staging).
# Vacío o ausente = mismo origen, sin CORS.
# NEXT_PUBLIC_LANDING_LEADS_BASE_URL=

# Opcional. Orígenes permitidos, separados por coma. Si se omite se usan
# veqto.ai, www.veqto.ai, NEXT_PUBLIC_APP_URL y localhost:3000.
# LANDING_LEADS_ALLOWED_ORIGINS=https://veqto.ai,https://www.veqto.ai

# Cloudflare Turnstile. El captcha se activa SOLO si TURNSTILE_SECRET_KEY está
# presente; en ese momento el token pasa a ser obligatorio y falta el widget en
# el front (ver PENDIENTE en el resumen del PR). El secreto no sale del servidor.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
